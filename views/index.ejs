<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>African Commodity Inspection | Mining & Cargo Inspection South Africa</title>
  <meta name="description" content="African Commodity Inspection is a South African mining and commodity inspection company providing independent quantity, quality and safety inspections across Africa." />
  <link rel="shortcut icon" href="./assets/aci.jpeg" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    :root {
      --bg: #050509;
      --bg-alt: #0c0f16;
      --card: #111623;
      --accent: #8d4600;              /* Orange */
      --accent-soft: rgba(255, 122, 26, 0.12);
      --text-main: #f7f7fb;
      --text-muted: #9ba3b5;
      --border-subtle: #1e2535;
      --danger: #e45b5b;
      --success: #46c38a;

      --max-width: 1120px;
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-pill: 999px;
      --shadow-soft: 0 24px 60px rgba(0, 0, 0, 0.6);

      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #151b28 0, #050509 52%);
      color: var(--text-main);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ::selection {
      background: var(--accent);
      color: #000;
    }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .shell {
      width: 100%;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* NAVBAR */
    .nav {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(18px);
      background: linear-gradient(
        to bottom,
        rgba(5, 5, 9, 0.96),
        rgba(5, 5, 9, 0.9),
        transparent
      );
      border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 0;
      gap: 1.25rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      background: radial-gradient(circle at 30% 10%, #ffe8d6, #ff7a1a 35%, #7c3b10 90%);
      position: relative;
      box-shadow: 0 12px 40px rgba(255, 122, 26, 0.25);
      overflow: hidden;
    }

    .brand-mark::before,
    .brand-mark::after {
      content: "";
      position: absolute;
      inset: 18%;
      border-radius: 999px;
      border: 2px solid rgba(0, 0, 0, 0.27);
      transform: rotate(-18deg);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }

    .brand-title {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .brand-sub {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--text-muted);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.9rem;
    }

    .nav-links a {
      color: var(--text-muted);
      padding-block: 0.35rem;
      position: relative;
    }

    .nav-links a:hover {
      color: var(--text-main);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.3rem;
      width: 0;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--accent), #ffc499);
      transition: width 0.2s ease-out;
    }

    .nav-links a:hover::after {
      width: 18px;
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .nav-chip {
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .btn {
      border-radius: var(--radius-pill);
      padding: 0.62rem 1.3rem;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      transition: transform 0.1s ease-out, box-shadow 0.1s ease-out,
        background 0.12s ease-out, color 0.12s ease-out;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), #ffc499);
      color: #1a120c;
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.6);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 55px rgba(0, 0, 0, 0.75);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-1px);
    }

    /* HERO */
    .hero {
      padding: 3rem 0 2.75rem;
    }

    .hero-grid {
      display: grid;
      gap: 2.5rem;
      align-items: center;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.18rem 0.55rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 122, 26, 0.5);
      background: linear-gradient(
        90deg,
        rgba(255, 122, 26, 0.13),
        rgba(24, 20, 10, 0.9)
      );
      color: var(--accent);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 1rem;
    }

    .hero-eyebrow span {
      height: 8px;
      width: 8px;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 0 3px rgba(255, 122, 26, 0.4);
    }

    .hero-title {
      font-size: clamp(2rem, 4vw, 2.9rem);
      letter-spacing: 0.03em;
      text-transform: uppercase;
      line-height: 1.18;
      margin-bottom: 1rem;
    }

    .hero-title span {
      color: var(--accent);
    }

    .hero-subtitle {
      max-width: 36rem;
      font-size: 0.98rem;
      color: var(--text-muted);
      margin-bottom: 1.75rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }

    .hero-metas {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .hero-metas strong {
      color: var(--text-main);
    }

    .hero-metas span {
      display: block;
    }

    .hero-right {
      position: relative;
    }

    .hero-img-wrap {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: var(--shadow-soft);
      position: relative;
    }

    .hero-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-img-tag {
      position: absolute;
      bottom: 0.9rem;
      left: 0.9rem;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-pill);
      background: rgba(5, 5, 9, 0.86);
      border: 1px solid rgba(255, 255, 255, 0.16);
      font-size: 0.7rem;
      color: var(--text-muted);
      backdrop-filter: blur(10px);
    }

    /* SECTION GENERIC */
    section {
      padding: 2.5rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.02);
    }

    .section-header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .section-eyebrow {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--accent);
      margin-bottom: 0.2rem;
    }

    .section-title {
      font-size: 1.35rem;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    .section-copy {
      max-width: 32rem;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* TRUST / PARTNERS */
    .trust-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text-muted);
      padding: 0.9rem 1rem;
      border-radius: var(--radius-md);
      background: rgba(5, 5, 9, 0.82);
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .trust-logos {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      opacity: 0.7;
    }

    .trust-pill {
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-pill);
      border: 1px dashed rgba(255, 255, 255, 0.15);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    /* SERVICES */
    .service-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.35rem;
    }

    .card {
      border-radius: var(--radius-lg);
      background: radial-gradient(circle at top, #161c29, #050509 58%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1.2rem 1.2rem 1.3rem;
      display: grid;
      gap: 0.8rem;
    }

    .card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .card-title {
      font-size: 0.98rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .card-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .card-badge {
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 122, 26, 0.55);
      font-size: 0.68rem;
      color: var(--accent);
      background: var(--accent-soft);
      white-space: nowrap;
    }

    .card-img {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      max-height: 160px;
    }

    .card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-body {
      font-size: 0.86rem;
      color: var(--text-muted);
    }

    .card-list {
      list-style: none;
      display: grid;
      gap: 0.32rem;
      font-size: 0.82rem;
      color: var(--text-main);
    }

    .card-list li::before {
      content: "•";
      color: var(--accent);
      margin-right: 0.4rem;
    }

    /* STATS BAND */
    .stats-band {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1.25rem;
      padding: 1.15rem 1.3rem;
      border-radius: var(--radius-lg);
      background: linear-gradient(
        120deg,
        rgba(40, 23, 11, 0.96),
        rgba(5, 5, 9, 0.96)
      );
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .stat-number {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    /* PROCESS */
    .process-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 1.75rem;
      align-items: flex-start;
    }

    .step-list {
      list-style: none;
      display: grid;
      gap: 0.9rem;
    }

    .step {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
      align-items: flex-start;
    }

    .step-index {
      height: 26px;
      width: 26px;
      border-radius: 999px;
      border: 1px solid rgba(255, 122, 26, 0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      color: var(--accent);
      background: rgba(5, 5, 9, 0.95);
    }

    .step-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.15rem;
    }

    .step-copy {
      font-size: 0.83rem;
      color: var(--text-muted);
    }

    .process-card {
      border-radius: var(--radius-lg);
      border: 1px dashed rgba(255, 255, 255, 0.18);
      padding: 1.1rem 1.2rem;
      background: rgba(5, 5, 9, 0.9);
      font-size: 0.84rem;
      color: var(--text-muted);
      display: grid;
      gap: 0.7rem;
    }

    .process-card strong {
      color: var(--text-main);
    }

    .process-img {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .process-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* INDUSTRIES / REGIONS */
    .pill-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .pill {
      padding: 0.32rem 0.9rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.78rem;
      color: var(--text-muted);
      background: rgba(5, 5, 9, 0.9);
    }

    .pill.highlight {
      border-color: rgba(255, 122, 26, 0.7);
      color: var(--accent);
      background: rgba(255, 122, 26, 0.1);
    }

    .commodities-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.1fr);
      gap: 1.5rem;
      align-items: flex-start;
    }

    .commodities-img {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .commodities-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* CREDIBILITY / AUDITS */
    .audit-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
      gap: 1.5rem;
      align-items: stretch;
    }

    .audit-card {
      border-radius: var(--radius-lg);
      padding: 1.2rem 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: radial-gradient(circle at top, #161c29, #050509 55%);
      font-size: 0.86rem;
      color: var(--text-muted);
      display: grid;
      gap: 0.8rem;
    }

    .audit-tag {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--accent);
    }

    .audit-title {
      font-size: 0.98rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .audit-list {
      list-style: none;
      display: grid;
      gap: 0.35rem;
      font-size: 0.82rem;
      color: var(--text-main);
    }

    .audit-list li::before {
      content: "▸";
      color: var(--accent);
      margin-right: 0.4rem;
    }

    .audit-img {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      max-height: 170px;
    }

    .audit-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* GALLERY */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.9rem;
    }

    .gallery-item {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.06);
      position: relative;
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .gallery-tag {
      position: absolute;
      left: 0.6rem;
      bottom: 0.6rem;
      padding: 0.18rem 0.6rem;
      border-radius: var(--radius-pill);
      background: rgba(5, 5, 9, 0.82);
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    /* CONTACT */
    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.9fr);
      gap: 1.75rem;
      align-items: flex-start;
    }

    .contact-card {
      border-radius: var(--radius-lg);
      padding: 1.3rem 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: radial-gradient(circle at top, #161c29, #050509 55%);
      box-shadow: var(--shadow-soft);
    }

    .contact-form {
      display: grid;
      gap: 0.9rem;
    }

    .field {
      display: grid;
      gap: 0.32rem;
    }

    .field label {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .input,
    .textarea,
    .select {
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
      background: rgba(5, 5, 9, 0.9);
      padding: 0.7rem 0.9rem;
      font-size: 0.85rem;
      color: var(--text-main);
      outline: none;
      transition: border 0.15s ease-out, box-shadow 0.15s ease-out,
        background 0.15s ease-out;
      width: 100%;
      font-family: inherit;
    }

    .textarea {
      border-radius: 14px;
      min-height: 90px;
      resize: vertical;
      line-height: 1.4;
    }

    .input:focus,
    .textarea:focus,
    .select:focus {
      border-color: rgba(255, 122, 26, 0.9);
      box-shadow: 0 0 0 1px rgba(255, 122, 26, 0.8);
      background: rgba(5, 5, 9, 0.96);
    }

    .contact-footnote {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin-top: 0.4rem;
    }

    .contact-side {
      font-size: 0.84rem;
      color: var(--text-muted);
      display: grid;
      gap: 1rem;
    }

    .contact-meta {
      display: grid;
      gap: 0.4rem;
    }

    .contact-meta strong {
      color: var(--text-main);
    }

    .contact-meta span {
      display: block;
    }

    .contact-chip {
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.18);
      font-size: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .contact-chip-dot {
      height: 8px;
      width: 8px;
      border-radius: 999px;
      background: var(--success);
    }

    .contact-img {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      max-height: 180px;
    }

    .contact-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* FOOTER */
    .footer {
      border-top: 1px solid rgba(255, 255, 255, 0.04);
      padding: 1.8rem 0 2rem;
      margin-top: 2rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-links a {
      color: var(--text-muted);
    }

    .footer-links a:hover {
      color: var(--text-main);
    }

    /* RESPONSIVE */
    @media (max-width: 960px) {
      .nav-inner {
        flex-wrap: wrap;
        row-gap: 0.75rem;
      }

      .nav-links {
        display: none;
      }

      .hero {
        padding-top: 2.5rem;
      }

      .hero-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .hero-right {
        order: -1;
      }

      .process-grid,
      .audit-grid,
      .contact-grid,
      .commodities-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 640px) {
      .shell {
        padding-inline: 1.1rem;
      }

      .nav-inner {
        padding-block: 0.8rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .stats-band {
        padding: 0.9rem 1rem;
      }

      .card,
      .contact-card {
        padding-inline: 1rem;
      }

      section {
        padding-block: 2.1rem;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="nav">
      <div class="shell nav-inner">
        <div class="brand">
